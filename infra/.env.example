# ---------------------------------------------------------------------------
# Infrastructure stack: Traefik, Keycloak, Kafka, Mosquitto, optional Ollama
# copy to .env and adjust - every setting is explained in docs/configuration.md
# ---------------------------------------------------------------------------

# Base domain of all services, e.g. home.arpa (local) or home.example.de (own domain)
DOMAIN=home.arpa
AUTH_HOST=auth.home.arpa
INVENTORY_HOST=inventar.home.arpa
# ntfy (push notifications); the ntfy app on the phones subscribes here
NTFY_HOST=ntfy.home.arpa

# TLS variant: choose the compose files
#  - local CA / own certificate in traefik/certs (scripts/create-local-ca.sh):
COMPOSE_FILE=docker-compose.yml
#  - Let's Encrypt via DNS-01 (set the ACME_* variables and the provider credentials below):
# COMPOSE_FILE=docker-compose.yml:docker-compose.letsencrypt.yml
# ACME_EMAIL=you@example.de
# ACME_DNS_PROVIDER=cloudflare      # https://doc.traefik.io/traefik/https/acme/#providers
# CF_DNS_API_TOKEN=...

TZ=Europe/Berlin

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me-too

# Mosquitto port published on the docker host (ESP32 scanners connect here)
MQTT_PORT=1883

# Local AI for the recipe imports (only with: docker compose --profile ollama up -d)
OLLAMA_MODEL=qwen3:8b

# Backup (service "backup", see docs/backup.md)
# target directory on the host (an NAS mount works too)
BACKUP_DIR=./backups
# cron schedule (local time) and how many daily / weekly (Sunday) / monthly (1st) backups to keep
BACKUP_SCHEDULE=30 2 * * *
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# ntfy: failures are always reported, success: weekly | always | never
NTFY_BACKUP_TOKEN=
BACKUP_NOTIFY_SUCCESS=weekly
# optional encrypted copy outside the house with restic (leave RESTIC_REPOSITORY empty to disable), e.g.
#   s3:https://s3.eu-central-1.amazonaws.com/my-bucket/home   (+ AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY)
#   b2:my-bucket:home                                        (+ B2_ACCOUNT_ID, B2_ACCOUNT_KEY)
#   sftp:user@nas:/backup/home
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
