# device-service: reads all device topics and answers on .../feedback and .../ota
user device-service
topic readwrite inventory/scanner/#

# Every device (scanner or button box) logs in with its device id as user name (e.g. "scanner-kueche")
# and may only use its own topics.
pattern write inventory/scanner/%u/scan
pattern write inventory/scanner/%u/button
pattern readwrite inventory/scanner/%u/status
pattern read inventory/scanner/%u/feedback
# firmware updates: command from the device-service, progress/result from the device
pattern read inventory/scanner/%u/ota
pattern write inventory/scanner/%u/otastate
