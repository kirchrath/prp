# ---------------------------------------------------------------------------
# Inventory stack (requires the infra stack: networks "proxy", "kafka" and "mqtt")
# copy to .env and adjust - every setting is explained in docs/configuration.md
# ---------------------------------------------------------------------------
INVENTORY_HOST=inventar.home.arpa
AUTH_HOST=auth.home.arpa
TZ=Europe/Berlin

DB_PASSWORD=change-me

# MQTT user of the device-service: infra/scripts/mqtt-user.sh add device-service
MQTT_PASSWORD=change-me

# Port on the docker host for firmware downloads of the ESP32 devices (OTA); must be reachable from the devices
OTA_PORT=8088

# Look up unknown barcodes in Open Food/Products/Beauty Facts
LOOKUP_ENABLED=true

# AI for recipe imports (link without structured data, free text, ingredient matching):
#   ollama    - local, start the infra stack with: docker compose --profile ollama up -d
#   anthropic - needs ANTHROPIC_API_KEY
#   openai    - needs OPENAI_API_KEY
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b
# OLLAMA_THINK=false
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# Daily best-before digest via ntfy (infra stack); token: infra/scripts/ntfy-user.sh service
NTFY_TOPIC=vorrat
NTFY_TOKEN=
