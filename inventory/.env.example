# ---------------------------------------------------------------------------
# Inventory stack (requires the infra stack: networks "proxy" and "mqtt")
# copy to .env and adjust
# ---------------------------------------------------------------------------
INVENTORY_HOST=inventar.home.arpa
AUTH_HOST=auth.home.arpa
TZ=Europe/Berlin

DB_PASSWORD=change-me

# MQTT user of the backend: infra/scripts/mqtt-user.sh add inventory-backend
MQTT_PASSWORD=change-me

# Look up unknown barcodes in Open Food/Products/Beauty Facts
LOOKUP_ENABLED=true
