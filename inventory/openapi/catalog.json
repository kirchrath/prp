          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CategorySaveDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      },
      "delete" : {
        "tags" : [ "Categories" ],
        "operationId" : "deleteCategory",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "version",
          "in" : "query",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
    },
    "/api/catalog/articles/{id}" : {
      "get" : {
        "tags" : [ "Articles" ],
        "operationId" : "getArticle",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ArticleDto"
                }
              }
            }
          }
        }
      },
      "put" : {
        "tags" : [ "Articles" ],
        "operationId" : "updateArticle",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ArticleSaveDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      },
      "delete" : {
        "tags" : [ "Articles" ],
        "operationId" : "deleteArticle",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "version",
          "in" : "query",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
    },
    "/api/catalog/categories" : {
      "get" : {
        "tags" : [ "Categories" ],
        "operationId" : "listCategories",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/CategoryListDto"
                  }
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "Categories" ],
        "operationId" : "createCategory",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CategorySaveDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        }
      }
    },
    "/api/catalog/articles" : {
      "get" : {
        "tags" : [ "Articles" ],
        "operationId" : "listArticles",
        "parameters" : [ {
          "name" : "search",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : [ "string", "null" ]
          }
        }, {
          "name" : "status",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : [ "string", "null" ],
            "enum" : [ "ACTIVE", "UNKNOWN" ]
          }
        }, {
          "name" : "categoryId",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : [ "string", "null" ],
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/ArticleListDto"
                  }
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "Articles" ],
        "operationId" : "createArticle",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ArticleSaveDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        }
      }
    },
    "/api/catalog/articles/{id}/merge-into/{targetId}" : {
      "post" : {
        "tags" : [ "Articles" ],
        "operationId" : "mergeArticle",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "targetId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "version",
          "in" : "query",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
    },
    "/api/catalog/articles/lookup/{ean}" : {
      "get" : {
        "tags" : [ "Articles" ],
        "operationId" : "lookupProduct",
        "parameters" : [ {
          "name" : "ean",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProductLookupDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog/articles/by-ean/{ean}" : {
      "get" : {
        "tags" : [ "Articles" ],
        "operationId" : "getArticleByEan",
        "parameters" : [ {
          "name" : "ean",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ArticleListDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "AuditDto" : {
        "type" : "object",
        "properties" : {
          "createdDate" : {
            "type" : "string",
            "format" : "date-time"
          },
          "lastModifiedDate" : {
            "type" : "string",
            "format" : "date-time"
          },
          "version" : {
            "type" : "integer",
            "format" : "int64"
          },
          "deleted" : {
            "type" : "boolean"
          }
        },
        "required" : [ "createdDate", "deleted", "lastModifiedDate", "version" ]
      },
      "CategoryDataDto" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          }
        },
        "required" : [ "name" ]
      },
      "CategorySaveDto" : {
        "type" : "object",
        "properties" : {
          "audit" : {
            "$ref" : "#/components/schemas/AuditDto"
          },
          "data" : {
            "$ref" : "#/components/schemas/CategoryDataDto"
          }
        },
        "required" : [ "data" ]
      },
      "ArticleDataDto" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "brand" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "packageSize" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "contentAmount" : {
            "type" : "number",
            "exclusiveMinimum" : 0
          },
          "contentUnit" : {
            "type" : "string",
            "enum" : [ "GRAM", "MILLILITER", "PIECE" ]
          },
          "imageUrl" : {
            "type" : "string",
            "maxLength" : 1000,
            "minLength" : 0
          },
          "categoryId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "minStock" : {
            "type" : "integer",
            "format" : "int32",
            "minimum" : 0
          },
          "eans" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "maxLength" : 64,
              "minLength" : 0
            }
          },
          "status" : {
            "type" : "string",
            "enum" : [ "ACTIVE", "UNKNOWN" ]
          },
          "source" : {
            "type" : "string",
            "enum" : [ "MANUAL", "OPEN_FOOD_FACTS", "OPEN_PRODUCTS_FACTS", "OPEN_BEAUTY_FACTS", "PLACEHOLDER" ]
          },
          "mergedInto" : {
            "type" : "string",
            "format" : "uuid"
          }
        },
        "required" : [ "eans", "minStock", "name" ]
      },
      "ArticleSaveDto" : {
        "type" : "object",
        "properties" : {
          "audit" : {
            "$ref" : "#/components/schemas/AuditDto"
          },
          "data" : {
            "$ref" : "#/components/schemas/ArticleDataDto"
          }
        },
        "required" : [ "data" ]
      },
      "CategoryListDto" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "name" ]
      },
      "CategoryDto" : {
        "type" : "object",
        "properties" : {
          "audit" : {
            "$ref" : "#/components/schemas/AuditDto"
          },
          "data" : {
            "$ref" : "#/components/schemas/CategoryDataDto"
          }
        },
        "required" : [ "audit", "data" ]
      },
      "ArticleListDto" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "brand" : {
            "type" : "string"
          },
          "packageSize" : {
            "type" : "string"
          },
          "imageUrl" : {
            "type" : "string"
          },
          "categoryId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "categoryName" : {
            "type" : "string"
          },
          "minStock" : {
            "type" : "integer",
            "format" : "int32"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "ACTIVE", "UNKNOWN" ]
          },
          "eans" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          }
        },
        "required" : [ "eans", "id", "minStock", "name", "status" ]
      },
      "ArticleDto" : {
        "type" : "object",
        "properties" : {
          "audit" : {
            "$ref" : "#/components/schemas/AuditDto"
          },
          "data" : {
            "$ref" : "#/components/schemas/ArticleDataDto"
          }
        },
        "required" : [ "audit", "data" ]
      },
      "ProductLookupDto" : {
        "type" : "object",
        "properties" : {
          "found" : {
            "type" : "boolean"
          },
          "name" : {
            "type" : "string"
          },
          "brand" : {
            "type" : "string"
          },
          "packageSize" : {
            "type" : "string"
          },
          "contentAmount" : {
            "type" : "number"
          },
          "contentUnit" : {
            "type" : "string",
            "enum" : [ "GRAM", "MILLILITER", "PIECE" ]
          },
          "imageUrl" : {
            "type" : "string"
          },
          "source" : {
            "type" : "string",
            "enum" : [ "MANUAL", "OPEN_FOOD_FACTS", "OPEN_PRODUCTS_FACTS", "OPEN_BEAUTY_FACTS", "PLACEHOLDER" ]
          },
          "existingArticleId" : {
            "type" : "string",
            "format" : "uuid"
          }
        },
        "required" : [ "found" ]
      }
    },
    "securitySchemes" : {
      "bearer" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    }
  }
}
