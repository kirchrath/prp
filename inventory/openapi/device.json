{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Device API",
    "version" : "v1"
  },
  "security" : [ {
    "bearer" : [ ]
  } ],
  "paths" : {
    "/api/device/scanners/{id}" : {
      "get" : {
        "tags" : [ "Scanners" ],
        "operationId" : "getScanner",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ScannerDto"
                }
              }
            }
          }
        }
      },
      "put" : {
        "tags" : [ "Scanners" ],
        "operationId" : "updateScanner",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ScannerSaveDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      },
      "delete" : {
        "tags" : [ "Scanners" ],
        "operationId" : "deleteScanner",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "version",
          "in" : "query",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
    },
    "/api/device/scanners" : {
      "get" : {
        "tags" : [ "Scanners" ],
        "operationId" : "listScanners",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/ScannerListDto"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "AuditDto" : {
        "type" : "object",
        "properties" : {
          "createdDate" : {
            "type" : "string",
            "format" : "date-time"
          },
          "lastModifiedDate" : {
            "type" : "string",
            "format" : "date-time"
          },
          "version" : {
            "type" : "integer",
            "format" : "int64"
          },
          "deleted" : {
            "type" : "boolean"
          }
        },
        "required" : [ "createdDate", "deleted", "lastModifiedDate", "version" ]
      },
      "ButtonDto" : {
        "type" : "object",
        "properties" : {
          "button" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 8,
            "minimum" : 1
          },
          "articleId" : {
            "type" : "string",
            "format" : "uuid"
          }
        },
        "required" : [ "articleId", "button" ]
      },
      "ScannerDataDto" : {
        "type" : "object",
        "properties" : {
          "deviceId" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "locationId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "online" : {
            "type" : "boolean"
          },
          "firmwareVersion" : {
            "type" : "string"
          },
          "ipAddress" : {
            "type" : "string"
          },
          "lastSeen" : {
            "type" : "string",
            "format" : "date-time"
          },
          "kind" : {
            "type" : "string",
            "enum" : [ "SCANNER", "BUTTONS" ]
          },
          "buttons" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ButtonDto"
            }
          }
        },
        "required" : [ "buttons", "online" ]
      },
      "ScannerSaveDto" : {
        "type" : "object",
        "properties" : {
          "audit" : {
            "$ref" : "#/components/schemas/AuditDto"
          },
          "data" : {
            "$ref" : "#/components/schemas/ScannerDataDto"
          }
        },
        "required" : [ "audit", "data" ]
      },
      "ScannerListDto" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "deviceId" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "locationId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "online" : {
            "type" : "boolean"
          },
          "firmwareVersion" : {
            "type" : "string"
          },
          "ipAddress" : {
            "type" : "string"
          },
          "lastSeen" : {
            "type" : "string",
            "format" : "date-time"
          },
          "kind" : {
            "type" : "string",
            "enum" : [ "SCANNER", "BUTTONS" ]
          },
          "buttons" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ButtonDto"
            }
          }
        },
        "required" : [ "buttons", "deviceId", "id", "kind", "online" ]
      },
      "ScannerDto" : {
        "type" : "object",
        "properties" : {
          "audit" : {
            "$ref" : "#/components/schemas/AuditDto"
          },
          "data" : {
            "$ref" : "#/components/schemas/ScannerDataDto"
          }
        },
        "required" : [ "audit", "data" ]
      }
    },
    "securitySchemes" : {
      "bearer" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    }
  }
}
