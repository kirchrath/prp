  "components" : {
    "schemas" : {
      "AuditDto" : {
        "type" : "object",
        "properties" : {
          "createdDate" : {
            "type" : "string",
            "format" : "date-time"
          },
          "lastModifiedDate" : {
            "type" : "string",
            "format" : "date-time"
          },
          "version" : {
            "type" : "integer",
            "format" : "int64"
          },
          "deleted" : {
            "type" : "boolean"
          }
        },
        "required" : [ "createdDate", "deleted", "lastModifiedDate", "version" ]
      },
      "IngredientDto" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "amount" : {
            "type" : "number",
            "exclusiveMinimum" : 0
          },
          "unit" : {
            "type" : "string",
            "enum" : [ "GRAM", "KILOGRAM", "MILLILITER", "LITER", "PIECE", "PACKAGE", "TABLESPOON", "TEASPOON", "PINCH", "OTHER" ]
          },
          "articleId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "basic" : {
            "type" : "boolean"
          }
        },
        "required" : [ "basic", "name" ]
      },
      "RecipeDataDto" : {
        "type" : "object",
        "properties" : {
          "title" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "description" : {
            "type" : "string",
            "maxLength" : 2000,
            "minLength" : 0
          },
          "servings" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 1
          },
          "prepMinutes" : {
            "type" : "integer",
            "format" : "int32",
            "minimum" : 0
          },
          "cookMinutes" : {
            "type" : "integer",
            "format" : "int32",
            "minimum" : 0
          },
          "imageUrl" : {
            "type" : "string",
            "maxLength" : 1000,
            "minLength" : 0
          },
          "sourceUrl" : {
            "type" : "string",
            "maxLength" : 1000,
            "minLength" : 0
          },
          "categoryId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "tags" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "maxLength" : 50,
              "minLength" : 0
            }
          },
          "steps" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "maxLength" : 4000,
              "minLength" : 0
            }
          },
          "ingredients" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/IngredientDto"
            }
          }
        },
        "required" : [ "ingredients", "servings", "steps", "tags", "title" ]
      },
