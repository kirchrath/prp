        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "amount" : {
            "type" : "number"
          },
          "unit" : {
            "type" : "string",
            "enum" : [ "GRAM", "KILOGRAM", "MILLILITER", "LITER", "PIECE", "PACKAGE", "TABLESPOON", "TEASPOON", "PINCH", "OTHER" ]
          },
          "articleId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "articleName" : {
            "type" : "string"
          },
          "packages" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "name", "packages" ]
