        "type" : "object",
        "properties" : {
          "url" : {
            "type" : "string",
            "maxLength" : 1000,
            "minLength" : 0,
            "pattern" : "https?://\\S+"
          }
        },
        "required" : [ "url" ]
      },
      "TextImportDto" : {
        "type" : "object",
        "properties" : {
          "text" : {
            "type" : "string",
            "maxLength" : 20000,
            "minLength" : 0
          }
        },
        "required" : [ "text" ]
      },
