          }
        },
        "required" : [ "audit", "data" ]
      },
      "ShoppingRequestItemDto" : {
        "type" : "object",
        "properties" : {
          "articleId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "text" : {
            "type" : "string"
          },
          "quantity" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "quantity", "text" ]
      },
      "RecipeListDto" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "title" : {
            "type" : "string"
          },
          "imageUrl" : {
            "type" : "string"
          },
          "categoryId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "categoryName" : {
            "type" : "string"
          },
          "tags" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "servings" : {
            "type" : "integer",
            "format" : "int32"
          },
          "totalMinutes" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "id", "servings", "tags", "title" ]
