            "type" : "string",
            "format" : "uuid"
          },
          "title" : {
            "type" : "string"
          },
          "imageUrl" : {
            "type" : "string"
          },
          "categoryName" : {
            "type" : "string"
          },
          "totalMinutes" : {
            "type" : "integer",
            "format" : "int32"
          },
          "cookable" : {
            "type" : "boolean"
          },
          "missing" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/MissingIngredientDto"
            }
          }
        },
        "required" : [ "cookable", "missing", "recipeId", "title" ]
      },
      "ShoppingRequestDataDto" : {
        "type" : "object",
        "properties" : {
          "recipeId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "recipeTitle" : {
            "type" : "string"
          },
          "servings" : {
            "type" : "integer",
            "format" : "int32"
          },
          "items" : {
            "type" : "array",
