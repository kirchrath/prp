{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Shopping API",
    "version" : "v1"
  },
  "security" : [ {
    "bearer" : [ ]
  } ],
  "paths" : {
    "/api/shopping/items/{id}" : {
      "get" : {
        "tags" : [ "ShoppingItems" ],
        "operationId" : "getShoppingItem",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ShoppingItemDto"
                }
              }
            }
          }
        }
      },
      "put" : {
        "tags" : [ "ShoppingItems" ],
        "operationId" : "updateShoppingItem",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ShoppingItemSaveDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      },
      "delete" : {
        "tags" : [ "ShoppingItems" ],
        "operationId" : "deleteShoppingItem",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "version",
          "in" : "query",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
    },
    "/api/shopping/items" : {
      "get" : {
        "tags" : [ "ShoppingItems" ],
        "operationId" : "listShoppingItems",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/ShoppingItemListDto"
                  }
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "ShoppingItems" ],
        "operationId" : "createShoppingItem",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ShoppingItemSaveDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        }
      }
    },
    "/api/shopping/items/done" : {
      "delete" : {
        "tags" : [ "ShoppingItems" ],
        "operationId" : "deleteDoneShoppingItems",
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "AuditDto" : {
        "type" : "object",
        "properties" : {
          "createdDate" : {
            "type" : "string",
            "format" : "date-time"
          },
          "lastModifiedDate" : {
            "type" : "string",
            "format" : "date-time"
          },
          "version" : {
            "type" : "integer",
            "format" : "int64"
          },
          "deleted" : {
            "type" : "boolean"
          }
        },
        "required" : [ "createdDate", "deleted", "lastModifiedDate", "version" ]
      },
      "ShoppingItemDataDto" : {
        "type" : "object",
        "properties" : {
          "articleId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "text" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "quantity" : {
            "type" : "integer",
            "format" : "int32",
            "minimum" : 1
          },
          "automatic" : {
            "type" : "boolean"
          },
          "done" : {
            "type" : "boolean"
          },
          "note" : {
            "type" : "string",
            "maxLength" : 500,
            "minLength" : 0
          }
        },
        "required" : [ "automatic", "done", "quantity" ]
      },
      "ShoppingItemSaveDto" : {
        "type" : "object",
        "properties" : {
          "audit" : {
            "$ref" : "#/components/schemas/AuditDto"
          },
          "data" : {
            "$ref" : "#/components/schemas/ShoppingItemDataDto"
          }
        },
        "required" : [ "data" ]
      },
      "ShoppingItemListDto" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "articleId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "label" : {
            "type" : "string"
          },
          "brand" : {
            "type" : "string"
          },
          "quantity" : {
            "type" : "integer",
            "format" : "int32"
          },
          "automatic" : {
            "type" : "boolean"
          },
          "done" : {
            "type" : "boolean"
          },
          "note" : {
            "type" : "string"
          }
        },
        "required" : [ "automatic", "done", "id", "label", "quantity" ]
      },
      "ShoppingItemDto" : {
        "type" : "object",
        "properties" : {
          "audit" : {
            "$ref" : "#/components/schemas/AuditDto"
          },
          "data" : {
            "$ref" : "#/components/schemas/ShoppingItemDataDto"
          }
        },
        "required" : [ "audit", "data" ]
      }
    },
    "securitySchemes" : {
      "bearer" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    }
  }
}
